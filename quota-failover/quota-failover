#!/usr/bin/env bash
# quota-failover - move limit-stopped Firstmate workers to the next live route.
#
# Usage: quota-failover <fm-home>
#
# One pass over <fm-home>/state/*.meta, under a non-blocking lock.
# A worker counts as stopped by a limit when its status says working (or it has
# none), it is not progressing (no status, turn-end, progress or re-arm write
# for QUOTA_FAILOVER_STALL_SECS, default 240), it is not busy unless the
# harness is only retrying a provider error (a session-retry busy event), and
# either its visible screen shows a provider limit error or its route's
# provider reads exhausted_now in quota-axi.
# A busy, progressing worker is never touched.
# A stopped worker moves to the first route, from the crew-dispatch rules that
# hold its current route and then the default, whose provider is not exhausted
# and that answers a one-prompt live test, through bin/fm-control.sh relaunch
# with a note naming the old route, the new route and why.
# A route held by an Opus-only rule only ever moves to another Opus route.
# Leads (secondmates) and remote tasks are detected and logged, never switched.
# Every decision is one line in state/quota-failover.log. A worker left with no
# live route also gets one failed line on the home's parent channel, if any.
set -u

die() { echo "quota-failover: $*" >&2; exit 1; }

home=${1:-${FM_HOME:-}}
[ -n "$home" ] && [ -d "$home/state" ] || die "usage: quota-failover <fm-home>"
FM_HOME=$(cd "$home" && pwd) || die "cannot read $home"
export FM_HOME
STATE=$FM_HOME/state BIN=$FM_HOME/bin LOG=$FM_HOME/state/quota-failover.log
DISPATCH=$FM_HOME/config/crew-dispatch.json
STALL=${QUOTA_FAILOVER_STALL_SECS:-240}
TEST_SECS=${QUOTA_FAILOVER_TEST_SECS:-90}
LIMIT_RE='(usage|rate|quota|weekly|monthly|daily|hour|session) limit (has been )?reached|hit your (usage )?limit|rate[ _-]?limit(ed|_error| exceeded)|quota (exceeded|exhausted)|exceeded your (current )?quota|insufficient[ _-]quota|too many requests|retrying in [0-9]+h'

exec 9>"$STATE/.quota-failover.lock" && flock -n 9 || exit 0
for lib in fm-backend.sh fm-busy-lib.sh fm-quota-axi-lib.sh fm-parent-channel-lib.sh; do
  # shellcheck source=/dev/null
  . "$BIN/$lib" || die "cannot load $BIN/$lib"
done

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"; }
# A repeated verdict is logged once until the task's last line changes.
note() { # <id> <text>
  [ "$(sed -n "s|^[^ ]* $1: ||p" "$LOG" 2>/dev/null | tail -n 1)" = "$2" ] || log "$1: $2"
}

QUOTA=$(quota-axi --json --no-credential-refresh --max-age "${QUOTA_FAILOVER_MAX_AGE:-10m}" 2>/dev/null)
fm_quota_json_valid <<<"$QUOTA" || QUOTA='{"schemaVersion":5,"providers":[]}'

provider() { # <harness> <model> [declared provider]
  [ -z "${3:-}" ] || { echo "$3"; return; }
  fm_quota_single_provider_for_harness "$1" 2>/dev/null && return
  case $2 in
    openai-codex/*|codex-native/*) echo codex ;;
    anthropic/*) echo claude ;;
    */*) echo "${2%%/*}" ;;
  esac
}

exhausted() { # <provider> <harness> <model>
  # Scope matching is bin/fm-dispatch-resolve.sh's: the model's bare name
  # against an exact model: or product: scope, and the account-wide scopes.
  [ -n "$1" ] && jq -e --arg p "$1" --arg h "$2" --arg m "$3" "$FM_QUOTA_ROW_JQ"'
    ($m | split("/") | last) as $b
    | [(quota_row(.; $p; quota_lane($h; $m)) // {}).quotaSemantics.effectiveAvailability[]?
      | select(.runway.status == "exhausted_now") | .scope as $s
      | select($s == "all_models" or $s == "all_products"
          or $s == ("model:" + $b) or $s == ("product:" + $b))]
    | length > 0' <<<"$QUOTA" >/dev/null
}

live_test() { # <harness> <model>: one prompt must come back answered
  local dir out rc prompt='Reply with the single word PONG.'
  dir=$(mktemp -d) || return 1
  out=$(cd "$dir" && case $1 in
    opencode*) timeout "$TEST_SECS" opencode run --model "$2" "$prompt" ;;
    pi*) timeout "$TEST_SECS" pi --model "$2" -p --no-session "$prompt" ;;
    claude*) timeout "$TEST_SECS" claude -p --model "$2" "$prompt" ;;
    codex*) timeout "$TEST_SECS" codex exec --skip-git-repo-check --model "$2" "$prompt" ;;
    *) exit 1 ;;
  esac 2>&1 </dev/null)
  rc=$?
  rm -rf "$dir"
  [ "$rc" = 0 ] && grep -q PONG <<<"$out" && ! grep -qiE "$LIMIT_RE" <<<"$out"
}

# Line 1: <opus-pinned> <declared provider of the route>; then one
# <harness> <model> <effort> <provider> line per candidate, in rule order.
# shellcheck disable=SC2016 # jq program text
CANDIDATES_JQ='
  def profiles: if type == "array" then .[] elif type == "object" then . else empty end;
  def same: .harness == $h and .model == $m;
  def opus: (.model // "") | test("opus"; "i");
  [.rules[]? | select(any(.use | profiles; same))] as $hit
  | ([$hit[].use | profiles] + [.default | profiles]) as $all
  | any($hit[]; all(.use | profiles; opus)) as $pinned
  | [$pinned, (first($all[] | select(same) | .provider // empty) // "")],
    (reduce $all[] as $p ([]; if any(.[]; .harness == $p.harness and .model == $p.model) then . else . + [$p] end)
     | .[] | select((same | not) and (($pinned | not) or opus))
     | [.harness, .model, .effort // "default", .provider // ""])
  | @tsv'

for meta in "$STATE"/*.meta; do
  [ -f "$meta" ] || continue
  id=${meta##*/} id=${id%.meta}
  [ ! -e "$STATE/$id.backlog-close" ] || continue
  # Busy-state is not progress: a harness retrying a limit rewrites it on every
  # attempt. busy-gen is re-armed at every spawn or relaunch, so a fresh
  # incarnation is never touched while its screen may still show the previous
  # run's last frame.
  newest=0
  for f in "$STATE/$id".{status,turn-ended,progress} "$STATE/$id.busy-gen"; do
    t=$(stat -c %Y "$f" 2>/dev/null) && [ "$t" -gt "$newest" ] && newest=$t
  done
  [ $(($(date +%s) - newest)) -ge "$STALL" ] || continue
  crew=$(FM_CREW_STATE_NO_FORGE=1 "$BIN/fm-crew-state.sh" "$id" 2>/dev/null) crew=${crew#state: } crew=${crew%% *}
  [[ $crew = working || $crew = unknown ]] || continue
  screen=$(fm_backend_visible_capture "$(fm_backend_of_meta "$meta")" "$(fm_backend_target_of_meta "$meta")" 2>/dev/null)
  # A harness only retrying a provider error is busy but not progressing: the
  # harness's own session status writes a session-retry busy event on every
  # attempt, and that worker moves like a stopped one.
  verdict=$(fm_busy_classify_meta "$meta" "$id" "$STATE" "$screen")
  [ "${verdict%% *}" != busy ] || [[ $(fm_busy_record_read "$STATE" "$id" 2>/dev/null) = *" session-retry "* ]] || continue

  h=$(fm_meta_get "$meta" harness) m=$(fm_meta_get "$meta" model) gen=$(fm_meta_get "$meta" spawn_gen)
  route="$h $m" cands=() pinned=false declared=
  [ -f "$DISPATCH" ] && { IFS=$'\t' read -r pinned declared; mapfile -t cands; } \
    < <(jq -r --arg h "$h" --arg m "$m" "$CANDIDATES_JQ" "$DISPATCH" 2>/dev/null)
  prov=$(provider "$h" "$m" "${declared:-}")
  if grep -qiE "$LIMIT_RE" <<<"$screen"; then
    why="its screen shows a provider limit error"
  elif exhausted "$prov" "$h" "$m"; then
    why="quota-axi reads provider $prov exhausted"
  else
    continue
  fi
  if [ "$(fm_meta_get "$meta" kind)" = secondmate ] || [ -n "$(fm_meta_get "$meta" remote_host)" ]; then
    note "$id" "lead on $route looks stopped by a limit ($why); not switched, lead routes are out of scope"
    continue
  fi

  next='' passed=''
  for c in "${cands[@]}"; do
    IFS=$'\t' read -r ch cm ce cp <<<"$c"
    if exhausted "$(provider "$ch" "$cm" "$cp")" "$ch" "$cm"; then passed+=", $cm exhausted"
    elif live_test "$ch" "$cm"; then next=$c; break
    else passed+=", $cm failed its live test"
    fi
  done
  why+=${passed:+; passed over ${passed#, }}
  if [ -z "$next" ]; then
    left="no live route in crew-dispatch"
    [ "${pinned:-false}" = false ] || left="Opus-only route and no live Opus route"
    note "$id" "stopped on $route ($why); $left, left waiting"
    fm_parent_channel_report "$FM_HOME" "$STATE" \
      "failed [key=quota-failover-$id]: quota-failover: $id is stopped by a usage limit on $route and no live route exists" \
      >/dev/null 2>&1 || true
    continue
  fi
  IFS=$'\t' read -r ch cm ce _ <<<"$next"
  [ "$(fm_meta_get "$meta" spawn_gen)" = "$gen" ] || continue
  notefile=$(mktemp)
  echo "quota-failover moved this task from $route to $ch $cm because $why. Continue the task from where it stopped." > "$notefile"
  if out=$("$BIN/fm-control.sh" "$id" relaunch --harness "$ch" --model "$cm" --effort "$ce" --note-file "$notefile" 2>&1); then
    log "$id: switched $route -> $ch $cm ($why)"
  else
    # The first error line is fm-control's cause; the last is rollback bookkeeping.
    log "$id: switch $route -> $ch $cm failed: $(grep -m1 '^error: ' <<<"$out" || tail -n 1 <<<"$out")"
  fi
  rm -f "$notefile"
done
