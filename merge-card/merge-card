#!/usr/bin/env bash
# merge-card: every Firstmate merge runs done-done and posts one evidence card to a sign-off board.
#
#   merge-card gate <task-id> <worktree|-> <head|-> <pr-url|->
#     Install as $FM_HOME/config/merge-gate. In the task's worktree it runs
#     `done-done check --from <pr-url>` (or $FM_HOME/data/<task-id>/checks.md with no PR),
#     with done-done's judge and each relative Checks evidence name resolved against
#     $FM_HOME/data/<task-id> before done-done checks it exists (--citation-base on done-done
#     0.3.1+; on an older one merge-card resolves the names itself), prints the verdict and
#     saves it for the card in $FM_HOME/data/<task-id>/merge-card.json.
#     done-done's verdict is report only. A PR merge is refused (exit 1) when
#     $FM_HOME/data/checks-gate.log has no pass row for the head from fm-checks-lint.sh.
#   merge-card check <task-id> <worktree|-> <head|-> <pr-url|->
#     The gate's check alone: run done-done, save and print the verdict, post nothing.
#   merge-card post --board <board.json> <task-id> <worktree|-> <head|-> <pr-url|->
#     Install as $FM_HOME/config/post-merge. Posts one evidence card per merge, and
#     only when the proof is real and passed: done-done's recorded verdict is pass,
#     the check names its claim (what a user can now do), and at least one proof
#     media file was copied, or a done-done verify run at the merged head brought
#     its own sign-off run. The card title is the claim; its media is the Checks
#     evidence screenshots and recordings (at most 12), or those of the verify run
#     through `done-done signoff`. The card carries the passed-test receipt (its `run`,
#     which sign-off's board checks against the run record to file it under Evidence): the
#     verify run's, else a sealed clean done-done run at the merged head in the task folder.
#     A merge with missing or unconfirmed proof posts no card: the gap is printed for the
#     merging lead and the lane owner fixes the proof and re-runs the post. The card key is
#     the merge's own, so a repeat post, or another home posting the same merge, finds it on
#     the board and adds nothing.
#     A PR whose Checks block says `screen: none` gets a text-only Evidence card when its
#     task folder has a sealed clean done-done receipt; the same key makes repeated posts no-ops.
#   merge-card screen-none <task-id> <pr-url|->, merge-card receipt <task-id> <head>
#     Exit 0 when the merge declares `screen: none`, or when the task folder holds a sealed clean
#     done-done run at <head>, there or in done-done's own evidence root (the card's passed-test receipt). Used by owner-rules' merge gate.
#     sign-off-axi writes the board under its lock: it appends and never rewrites other cards.
# Needs done-done on PATH (0.3.1+ cites the task folder's evidence itself; an older one is
# still covered), sign-off-axi, jq and gh.
set -u

die() { echo "merge-card: $*" >&2; exit 1; }

# version_at_least <version> <minimum>: a dotted numeric version of at least the minimum.
version_at_least() {
  case $1 in
    [0-9]*.[0-9]*) ;;
    *) return 1 ;;
  esac
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" = "$2" ]
}

# not_checked_reason <output>: the one line of <output> that names why done-done could not check.
not_checked_reason() {
  local why
  why=$(printf '%s\n' "$1" | jq -r 'if type == "object" then (.error // empty) else empty end' 2>/dev/null | head -n 1)
  [ -n "$why" ] || why=$(printf '%s\n' "$1" | sed 's/^.*: line [0-9][0-9]*: //' | head -n 1)
  printf '%s' "${why:0:100}"
}

# resolve_evidence <dir>: stdin with each relative file name on an `evidence:` line resolved
# against <dir>, split and trimmed as done-done reads them; absolute names and "not proven" stay.
resolve_evidence() {
  jq -Rr --arg base "$1" '
    if test("^\\s*evidence\\s*:") and (test("^\\s*evidence\\s*:\\s*not proven"; "i") | not)
    then sub("(?<k>^\\s*evidence\\s*:)(?<v>.*)$"; "\(.k)\(.v | gsub("(?<p>(^|[\\s,])[`\\x27\"(]*)(?<f>[^\\s,`\\x27\"(/][^\\s,`\\x27\"]*\\.\\w{1,10})(?=[`\\x27\"),.;]*([\\s,]|$))"; "\(.p)\($base)/\(.f)"))")
    else . end'
}

# check <task-id> <worktree|-> <head|-> <pr-url|->: run done-done, save and print the verdict.
check() {
  [ $# -eq 4 ] || { echo "usage: merge-card check <task-id> <worktree|-> <head|-> <pr-url|->"; return; }
  [ -n "${FM_HOME:-}" ] || { echo "merge-card: FM_HOME is not set, so done-done did not run"; return; }
  local id=$1 wt=$2 head=$3 pr=$4 src out='' rc=0 verdict signoff=''
  local record=$FM_HOME/data/$id/merge-card.json dd_v='' args body reason
  src=$pr
  [ "$pr" != - ] || src=$FM_HOME/data/$id/checks.md
  if [ "$wt" = - ] || [ ! -d "$wt" ]; then
    verdict="not checked: its work copy was already cleaned up"
  else
    # The Checks evidence lives in the task folder, so relative names resolve there before
    # done-done checks that each file exists (absolute paths stay unchanged); the work copy is
    # only the repo identity. A done-done of 0.3.1 or newer does that itself with --citation-base;
    # an older one rejects the flag and resolves against its cwd, so probe once (offline, cheap)
    # and, on the older one, hand it the Checks block with its names already resolved, on stdin.
    dd_v=$(done-done --version 2>/dev/null | head -n 1)
    if done-done check --help 2>&1 | grep -q -- '--citation-base' ||
       version_at_least "$dd_v" 0.3.1; then
      out=$(cd "$wt" && done-done check --from "$src" --json --citation-base "$FM_HOME/data/$id" 2>&1) || rc=$?
    else
      args=()
      if [ "$pr" = - ]; then
        body=$(cat -- "$src" 2>&1) || rc=2
      elif body=$(gh pr view "$pr" --json body,headRefName 2>&1); then
        # --from - drops the PR branch, done-done's default claim id for a PR, so name it.
        args=(--claim-id "$(jq -r .headRefName <<<"$body")") && body=$(jq -r .body <<<"$body")
      else
        rc=2
      fi
      if [ "$rc" = 0 ]; then
        out=$(cd "$wt" && resolve_evidence "$FM_HOME/data/$id" <<<"$body" | done-done check --from - "${args[@]}" --json 2>&1) || rc=$?
      else
        out=$body
      fi
    fi
    case $rc in
      0) verdict=pass ;;
      1) verdict=fail ;;
      3) verdict=inconclusive ;;
      # An exit 2 is a usage or config stop, not a proof result: report it as not checked.
      *) case $out in
           *"no judge is set"*) verdict="not checked: no judge is set" ;;
           *"Unknown option '--citation-base'"*) verdict="not checked: installed done-done${dd_v:+ $dd_v} rejects --citation-base" ;;
           *) reason=$(not_checked_reason "$out")
              [ -n "$reason" ] && verdict="not checked: $reason" || verdict="error (exit $rc)" ;;
         esac ;;
    esac
    # A done-done verify run at this exact head brings its own sign-off message and captures.
    signoff=$(cd "$wt" && done-done signoff --json 2>/dev/null | jq -r 'select(.kind == "evidence") | .file // empty')
    { [ -n "$signoff" ] && [ "$(jq -r .run.commit "$signoff" 2>/dev/null)" = "$head" ]; } || signoff=''
  fi
  printf '%s' "$out" | jq -e 'type == "object"' >/dev/null 2>&1 || out=$(jq -n --arg e "$out" 'if $e == "" then {} else {error: $e} end')
  mkdir -p "${record%/*}" &&
    jq -n --arg head "$head" --arg pr "$pr" --arg verdict "$verdict" --arg signoff "$signoff" --argjson check "$out" \
      '{$head, $pr, $verdict, $signoff, $check}' > "$record.$$" && mv "$record.$$" "$record"
  echo "done-done check: $verdict ($src)"
  printf '%s' "$out" | jq -r '(.findings // [])[:3][].why, (.error // empty)' | sed 's/^/  /'
}

gate() {
  [ $# -eq 4 ] || { echo "usage: merge-card gate <task-id> <worktree|-> <head|-> <pr-url|->"; return; }
  [ -n "${FM_HOME:-}" ] || { echo "merge-card: FM_HOME is not set, so done-done did not run"; return; }
  check "$1" "$2" "$3" "$4"
  echo "merge-card: report only; done-done's verdict never refuses this merge"
  [ "$4" != - ] && [ "$3" != - ] || return 0
  # Row: <time> <src> <head> pass|fail <why>, one per fm-checks-lint.sh run.
  awk -F'\t' -v h="$3" '$3 == h && $4 == "pass" { f = 1 } END { exit !f }' "$FM_HOME/data/checks-gate.log" 2>/dev/null && return 0
  echo "merge refused: no checks-lint PASS row for head $3 in data/checks-gate.log; run fm-checks-lint.sh on this PR until PASS"
  return 1
}

# dd_root: done-done's own evidence root, asked of done-done (`doctor`
# prints <root>/<app>); nothing when done-done is absent or does not answer, so only the task folder counts.
dd_root() {
  local root
  root=$(cd "$FM_HOME" 2>/dev/null && done-done doctor --json 2>/dev/null |
    jq -r '.checks[]? | select(.check == "evidence_root") | .detail | capture("^writable: (?<p>.+)/[^/]+$").p' 2>/dev/null)
  printf '%s' "${root/#\~/$HOME}"
}

# receipt_run <task-id> <head> <record>: the first sealed clean done-done run at <head>, from the task folder or
# done-done's default evidence root, else nothing.
receipt_run() {
  local claim evidence root ddruns=()
  root=$(dd_root)
  [ -z "$root" ] || ddruns=("$root"/*/.done-done/runs/*.json)
  claim=$(jq -r '.check.claim // empty' "$3" 2>/dev/null)
  evidence=$(jq -r '[.check.evidence[]? | split("/") | last] | join(", ")' "$3" 2>/dev/null)
  jq -cs --arg head "$2" --arg claim "$claim" --arg ev "$evidence" '
    map(select(.schema == 1 and .exit == 0 and .dirty == false and .commit == $head and (.files | length) > 0 and (.run_id // "") != ""))
    | .[0] // empty
    | {run_id, commit, outcome: $claim, repro: "see the merge note", proof: "done-done run \(.run_id)", evidence: $ev}' "$FM_HOME"/data/"$1"/.done-done/runs/*.json "${ddruns[@]}" 2>/dev/null
}

# screen_none <task-id> <pr-url|->: the merge's Checks block declares `screen: none`.
screen_none() {
  { [ "$2" != - ] && gh pr view "$2" --json body --jq .body 2>/dev/null || cat -- "$FM_HOME/data/$1/checks.md" 2>/dev/null; } |
    grep -qiE '^[[:space:]]*screen[[:space:]]*:[[:space:]]*none[[:space:]]*$'
}

post() {
  local board='' id wt head pr record key link title about kind media run receipt=null media_dir out rc n=0 f verdict claim
  [ "${1:-}" = --board ] && [ -n "${2:-}" ] && board=$2 && shift 2
  [ -n "$board" ] && [ $# -eq 4 ] || die "usage: merge-card post --board <board.json> <task-id> <worktree|-> <head|-> <pr-url|->"
  [ -n "${FM_HOME:-}" ] || die "FM_HOME is not set"
  id=$1 wt=$2 head=$3 pr=$4 record=$FM_HOME/data/$1/merge-card.json
  if [ "$pr" != - ]; then
    key=${pr#*://} link=$pr
    key=merge-$(printf '%s' "${key#*/}" | tr -c 'A-Za-z0-9._-' -)
  else
    [ "$head" != - ] || die "a local merge needs its head"
    key=merge-$head link=$head
  fi
  key=${key:0:128}
  local replace=''
  if [ -f "$board" ] && jq -e --arg k "$key" 'any(.items[]?; .key == $k)' "$board" >/dev/null; then
    if sign-off-axi list "$board" --json | jq -e --arg k "$key" 'any(.decisions[]?; .key == $k and .dismissed == true)' >/dev/null; then
      sign-off-axi restore "$key" "$board" >/dev/null || die "sign-off-axi could not restore dismissed $key"
      replace=--replace
    else
      echo "merge-card: $key is already on the board"; return 0
    fi
  fi
  # Screen-free PRs use their sealed done-done receipt as a short text-only card.
  if screen_none "$id" "$pr"; then
    local text_run
    text_run=$(receipt_run "$id" "$head" "$record")
    [ -n "$text_run" ] || { echo "merge-card: no passed-test receipt for $key"; return 1; }
    local outcome evidence body
    outcome=$(jq -r '.check.claim // empty' "$record")
    evidence=$(jq -r '[.check.evidence[]? | split("/") | last] | join(", ")' "$record")
    if [ -z "$outcome" ]; then
      if [ "$pr" != - ]; then body=$(gh pr view "$pr" --json body --jq .body 2>/dev/null); else body=$(cat -- "$FM_HOME/data/$id/checks.md" 2>/dev/null); fi
      outcome=$(printf '%s\n' "$body" | sed -n 's/^outcome: *//p' | head -n 1)
      evidence=$(printf '%s\n' "$body" | sed -n 's/^evidence: *//p' | head -n 1)
      [ -n "$evidence" ] || evidence='sealed done-done run'
    fi
    outcome=${outcome:0:1000}
    text_run=$(jq -c --arg outcome "$outcome" --arg evidence "$evidence" '.outcome=$outcome | .evidence=$evidence' <<<"$text_run")
    [ -n "$outcome" ] || { echo "merge-card: no Checks outcome for $key"; return 1; }
    media_dir=$FM_HOME/data/$id/merge-card-media
    mkdir -p "$media_dir" || die "cannot create the task's persistent media folder"
    jq -n --arg key "$key" --arg link "$link" --argjson run "$text_run" \
      '{contract:1,kind:"evidence",schema:1,key:$key,title:"Internal change passed its checks",about:"No user-visible screen; sealed done-done receipt attached.",link:$link,run:$run}' > "$media_dir/card.json" || die "cannot write the card"
    if [ -n "$replace" ]; then
      jq --slurpfile c "$media_dir/card.json" --arg k "$key" '.items = ([.items[]? | select(.key != $k)] + [$c[0]])' "$board" > "$media_dir/feed.json" || die "cannot prepare replacement for $key"
      out=$(sign-off-axi post "$board" --from "$media_dir/feed.json" --replace 2>&1) || die "sign-off-axi could not post $key: $out"
    else
      out=$(sign-off-axi post "$board" --kind evidence --from "$media_dir/card.json" --filer firstmate-merge 2>&1) || die "sign-off-axi could not post $key (exit $?)"
    fi
    [ -z "$out" ] || printf '%s\n' "$out"
    echo "merge-card: posted text-only $key evidence card"
    return 0
  fi
  # The gate's verdict for this merge, else run done-done now (a merge the gate never saw).
  jq -e --arg pr "$pr" --arg head "$head" '.pr == $pr and ($pr != "-" or .head == $head)' "$record" >/dev/null 2>&1 || {
    [ "$head" != - ] || head=$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>/dev/null) || head=-
    check "$id" "$wt" "${head:--}" "$pr"
  }
  verdict=$(jq -r '.verdict // empty' "$record")
  claim=$(jq -r '.check.claim // empty' "$record")
  # Evidence only: a merge without passed proof posts no card, and the gap goes
  # back to the lane owner to fix the proof and re-run the post. Never fail the
  # merge over it.
  if [ "$verdict" != pass ]; then
    echo "merge-card: no evidence card for $key: done-done verdict is ${verdict:-unknown}; the lane owner must fix the proof (real screens or a clip that done-done passes) and re-run merge-card post"
    return 0
  fi
  if [ -z "$claim" ]; then
    echo "merge-card: no evidence card for $key: the passed check names no claim; the lane owner must fix the proof (real screens or a clip that done-done passes) and re-run merge-card post"
    return 0
  fi
  title=$claim
  # done-done's verdict in plain words, then its first finding (or the judge's reason on a pass)
  # with the file named without its folder, so the card shows no local paths.
  about=$(jq -r '
    def plain: sub("^/[^ ]*/"; "")
      | sub(": not in any done-done run record, so it is not tied to a commit"; " was captured by hand, not in a done-done run, so nothing ties it to this commit")
      | sub(": judge says wrong screen: "; " does not show the outcome: ")
      | sub(": judge says unsure: .*"; " may not show the outcome: the judge was not sure");
    ({pass: "done-done checked the proof and it holds up", fail: "done-done checked the proof and it does not hold up",
      inconclusive: "done-done could not confirm the proof"}[.verdict]
      // if (.verdict | startswith("not checked")) then "done-done did not check this merge: " + (.verdict | sub("^not checked: "; ""))
         else "done-done could not run (" + .verdict + ")" end)
    + ([(.check.findings[]?.why | plain), (.check.judge.judged[]? | select(.verdict == "pass") | .reason)][:1] | map(": " + .) | join(""))' "$record")
  media_dir=$FM_HOME/data/$id/merge-card-media
  mkdir -p "$media_dir" || die "cannot create the task's persistent media folder"
  # Media and run: the verify run's sign-off message, else the Checks evidence files.
  f=$(jq -r '.signoff' "$record")
  if [ -n "$f" ] && [ -f "$f" ]; then
    run=$(jq -c .run "$f")
    media=$(jq -r '.media[]?' "$f" | sed "s|^|${f%/*}/|")
  else
    run=null
    receipt=$(receipt_run "$id" "$head" "$record"); receipt=${receipt:-null}
    media=$(jq -r '.check.evidence[]? | select(test("\\.(png|jpe?g|webp|mp4|webm)$"; "i"))' "$record")
  fi
  while IFS= read -r f; do
    [ -f "$f" ] && [ "$n" -lt 12 ] || continue
    n=$((n + 1)) && cp "$f" "$media_dir/$n.$(printf '%s' "${f##*.}" | tr '[:upper:]' '[:lower:]')"
  done <<< "$media"
  media=$(cd "$media_dir" && for f in $(seq 1 "$n"); do printf '%s\n' "$f".*; done | jq -R . | jq -s .)
  if [ "$n" -eq 0 ] && [ "$run" = null ]; then
    echo "merge-card: no evidence card for $key: no passed proof media; the lane owner must fix the proof (real screens or a clip that done-done passes) and re-run merge-card post"
    return 0
  fi
  kind=evidence
  if [ "$run" = null ]; then run=$receipt; fi
  jq -n --arg kind "$kind" --arg key "$key" --arg title "$title" --arg about "$about" --arg link "$link" \
    --argjson run "$run" --argjson media "$media" '
    def clean(max): gsub("[\u0000-\u0009\u000b-\u001f\u007f-\u009f]"; " ") | if length > max then .[:max - 3] + "..." else . end;
    {contract: 1, kind: $kind, schema: 1, key: $key, title: ($title | clean(160)), about: ($about | clean(500)), link: $link}
    + if $media != [] then {media: $media} else {} end
    + if $run != null then {run: $run} else {} end' > "$media_dir/card.json" || die "cannot write the card"
  for _ in 1 2 3; do
    rc=0
    if [ -n "$replace" ]; then
      jq --slurpfile c "$media_dir/card.json" --arg k "$key" '.items = ([.items[]? | select(.key != $k)] + [$c[0]])' "$board" > "$media_dir/feed.json" || die "cannot prepare replacement for $key"
      out=$(sign-off-axi post "$board" --from "$media_dir/feed.json" --replace 2>&1) || rc=$?
    else
      out=$(sign-off-axi post "$board" --kind "$kind" --from "$media_dir/card.json" --filer firstmate-merge 2>&1) || rc=$?
    fi
    case $out in
      *"already holds a different"* | *"is already used"*) echo "merge-card: $key is already on the board"; return 0 ;;
      *BUSY* | *"still writing"*) sleep 2 ;;
      *) break ;;
    esac
  done
  printf '%s\n' "$out"
  [ "$rc" -eq 0 ] || die "sign-off-axi could not post $key (exit $rc)"
  echo "merge-card: posted $key ($kind, $n media, $about)"
  # Tie the evidence folder to the lint row's PR and head.
  printf '%s\t%s\t%s\tcard\tevidence folder %s\n' "$(date -u +%FT%TZ)" "$pr" "$head" "$FM_HOME/data/$id" >> "$FM_HOME/data/checks-gate.log"
}

case ${1:-} in
  gate) shift; gate "$@"; exit $? ;;
  check) shift; check "$@"; exit 0 ;;
  post) shift; post "$@" ;;
  # For owner-rules' merge gate: exit 0 when the merge is exempt / has a sealed clean run at <head>.
  screen-none) [ -n "${FM_HOME:-}" ] && screen_none "${2:-}" "${3:--}"; exit $? ;;
  receipt) [ -n "${FM_HOME:-}" ] && [ -n "$(receipt_run "${2:-}" "${3:-}" /dev/null)" ]; exit $? ;;
  *) die "usage: merge-card gate|check|post ... (see the header of $0)" ;;
esac
