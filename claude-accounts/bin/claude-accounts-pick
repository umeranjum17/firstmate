#!/usr/bin/env bash
# claude-accounts-pick - config/account-pool's `command=` for a home that spreads new Claude workers over
# every signed-in Claude account. fm-spawn runs `<command> pick <tool> --json [--prefer <id>] --state <dir>`
# for each new worker; the answer names one existing profile folder for CLAUDE_CONFIG_DIR and the credential
# variable names to unset (names only). The account with the most runway wins: the larger of the two
# windows' tighter side (min of 5h and 7d left). An account under FM_CLAUDE_ACCOUNTS_LOW percent (default 5)
# is skipped, so new workers go to the other account when one runs low. A running worker is never moved:
# the pick only happens at launch. Other tools get their ambient default folder, unchanged.
# A quota-reader failure never refuses a launch. The roster comes from the registry (id, name, folder);
# the reading is whatever the last good run left on disk, in <home>/state or in the pool state folder,
# whichever is newer. A reading older than FM_CLAUDE_ACCOUNTS_STALE_MAX (3600 s) still counts by its 7-day
# side alone, which is the window that decays slowly, and an account with no reading at all ranks last but
# is still picked. The answer carries `read`: where the numbers came from, and how old they are. An account
# whose last reading says it must sign in again is skipped, however much runway it shows, so a signed-out
# profile never wins on a stale number. The pick fails only when the pool itself has nothing to offer: every
# account rested, every known runway under the low mark, or no registry account with an existing folder.
# `status <id> --json` names the tool and folder of one account and `rest <id> --json` sets it aside (5 h, or
# until its 5h window resets) so the next pick moves to the other account; `unrest <id>` returns it. A rested
# account is never replaced by a paid fallback: with every account rested the pick refuses.
# Env: FM_HOME (the home whose state holds the reading; optional - --state alone is enough),
# FM_CLAUDE_ACCOUNTS_REGISTRY, FM_CLAUDE_ACCOUNTS_FRESH (seconds a reading is reused, 120).
set -uo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SHED='CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY CLAUDE_CODE_USE_ANTHROPIC_AWS CLAUDE_CODE_USE_MANTLE ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_PROFILE ANTHROPIC_FEDERATION_RULE_ID'

fail() { jq -cn --arg r "$1" '{ok: false, reason: $r}'; echo "error: $1" >&2; exit 1; }
usage="usage: claude-accounts-pick pick <tool> --json [--prefer <id>] --state <dir>"
verb=${1:-}
case "$verb" in pick | status | rest | unrest) ;; *) fail "$usage" ;; esac
[ -n "${2:-}" ] || fail "$usage"
tool=$2
shift 2
prefer=
state=
while [ $# -gt 0 ]; do
  case "$1" in --prefer) prefer=${2:-}; shift ;; --state) state=${2:-}; shift ;; esac
  shift
done

REGISTRY=${FM_CLAUDE_ACCOUNTS_REGISTRY:-$HOME/.muxr/plans/accounts-v1.json}
if [ "$verb" != pick ]; then
  id=$tool
  jq -e --arg id "$id" 'any(.accounts[]?; .provider == "claude" and .id == $id)' "$REGISTRY" >/dev/null 2>&1 \
    || fail "no Claude account $id in the pool"
  rested=${state:-${FM_HOME:+$FM_HOME/state}}/claude-accounts-rested
  [ -n "$rested" ] || fail "$verb $id needs the pool state folder: pass --state <dir> or set FM_HOME"
  case "$verb" in
    status) jq -cn --arg id "$id" --arg f "$(jq -r --arg id "$id" 'first(.accounts[]? | select(.provider == "claude" and .id == $id) | .folder)' "$REGISTRY")" \
      '{ok: true, id: $id, tool: "claude", folder: $f}' ;;
    rest)
      mkdir -p "$rested" || fail "cannot write the rested list in $rested"
      echo $(($(date +%s) + ${FM_CLAUDE_ACCOUNTS_REST_SECONDS:-18000})) >"$rested/$id" || fail "cannot rest $id in $rested"
      jq -cn --arg id "$id" '{ok: true, id: $id, rested: true}' ;;
    unrest) rm -f "$rested/$id"; jq -cn --arg id "$id" '{ok: true, id: $id, rested: false}' ;;
  esac
  exit 0
fi

case "$tool" in
  claude) ;;
  codex) jq -cn --arg d "${CODEX_HOME:-$HOME/.codex}" '{ok: true, id: "ambient", set: {CODEX_HOME: $d}, unset: []}'; exit 0 ;;
  pi) jq -cn --arg d "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" '{ok: true, id: "ambient", set: {PI_CODING_AGENT_DIR: $d}, unset: []}'; exit 0 ;;
  *) fail "no account choice for $tool" ;;
esac

# The roster: the registry is the list of accounts, the reading only fills in the numbers.
roster=$(jq -c '[.accounts[]? | select(.provider == "claude" and (.folder | type) == "string" and (.folder | startswith("/")))
  | {id, name: (.name // ""), folder}]' "$REGISTRY" 2>/dev/null) || roster=''
[ -n "$roster" ] && [ "$roster" != '[]' ] || fail "no Claude account with a folder in $REGISTRY"

# The last good reading: <home>/state and the pool state folder, whichever the reader wrote last.
# A file the reader just wrote with nothing but errors carries no window at all, so a file that still
# has one wins over it whatever its age.
candidates=("${FM_HOME:+$FM_HOME/state/claude-accounts.json}" "${state:+$state/claude-accounts.json}")
scan_reading() {
  local f at score best=-1
  file=''; newest=0
  for f in "${candidates[@]}"; do
    [ -n "$f" ] && [ -r "$f" ] || continue
    at=$(jq -r '.generated_at // 0' "$f" 2>/dev/null) || continue
    case "$at" in '' | *[!0-9]*) continue ;; esac
    score=$(( at + $(jq -r 'if any(.accounts[]?; .five_hour != null or .seven_day != null) then 100000000000000 else 0 end' "$f" 2>/dev/null || echo 0) ))
    [ "$score" -gt "$best" ] && { best=$score; newest=$at; file=$f; }
  done
}
scan_reading
read_err=''
if [ -z "$file" ] || [ "$((newest + ${FM_CLAUDE_ACCOUNTS_FRESH:-120}))" -le "$(date +%s)" ]; then
  # Try a fresh reading when there is a home to write it to. A reader failure is a note, never a refusal.
  if [ -n "${FM_HOME:-}" ]; then
    read_err=$("$here/claude-accounts-quota.sh" 2>&1 >/dev/null) || :
    [ -s "${FM_HOME}/state/claude-accounts.json" ] || read_err=${read_err:-the quota reader wrote no reading}
    scan_reading
  else
    read_err=${read_err:-FM_HOME is unset, so the last good reading on disk is the only number there is}
  fi
fi
[ -n "$read_err" ] && read_err=${read_err%%$'\n'*}
reading=$([ -s "${file:-}" ] && cat "$file" 2>/dev/null || echo null)

low=${FM_CLAUDE_ACCOUNTS_LOW:-5}
rested_dir=${state:-${FM_HOME:+$FM_HOME/state}}/claude-accounts-rested
rested_ids=$(for f in "$rested_dir"/*; do
  [ -f "$f" ] && [ "$(cat "$f" 2>/dev/null)" -gt "$(date +%s)" ] 2>/dev/null && basename "$f"
done | jq -Rsc 'split("\n") | map(select(. != ""))')

# tier 0: a reading young enough to trust, ranked on min(5h, 7d). tier 1: an older reading, ranked on its
# 7-day side alone. tier 2: no reading at all, ranked last so a known account always wins. An account whose
# last reading says it must sign in again is out whatever it shows.
# shellcheck disable=SC2016 # jq program text
pick=$(jq -cn --arg prefer "$prefer" --argjson low "$low" --argjson now "$(date +%s)" \
    --argjson max "${FM_CLAUDE_ACCOUNTS_STALE_MAX:-3600}" --argjson rested "$rested_ids" --argjson read "$reading" '
  ($read // {}) as $rd
  | def sign_in: test("sign-?in|log ?in|unauthenticated|not authenticated|no credentials"; "i");
  [ $roster[] as $r
    | (($rd.accounts // []) | map(select(.id == $r.id)) | first // {}) as $m
    | ($m.read_at // $rd.generated_at // 0) as $at
    | (if ($m.problem == null and ($m.five_hour != null or $m.seven_day != null) and $now - $at <= $max) then 0
       elif $m.seven_day != null then 1 else 2 end) as $tier
    | {id: $r.id, name: $r.name, folder: $r.folder, tier: $tier, read_at: $at,
       runway: (if $tier == 0 then ([$m.five_hour.left, $m.seven_day.left] | map(select(. != null)) | min)
                 elif $tier == 1 then $m.seven_day.left else -1 end)}
    | select(([.id] | inside($rested) | not) and ((($m.problem // "") | sign_in) | not))
    | select(.runway < 0 or .runway >= $low)
    | select($prefer == "" or $prefer == "next" or .id == $prefer)]
  | sort_by(.tier, -.runway) | first // empty' --argjson roster "$roster")
[ -n "$pick" ] || fail "no Claude account can take a worker${prefer:+ (asked for $prefer)}: each is resting, signed out, or under $low% left${read_err:+ (quota reading unavailable: $read_err)}"
folder=$(jq -r '.folder' <<<"$pick")
[ -d "$folder" ] || fail "the chosen Claude account's folder is missing"
tier=$(jq -r '.tier' <<<"$pick"); at=$(jq -r '.read_at // 0' <<<"$pick")
case $tier in 0) source=reading ;; 1) source=last-good ;; *) source=none ;; esac
jq -cn --argjson p "$pick" --arg shed "$SHED" --arg source "$source" --argjson at "${at:-0}" \
  --argjson age "$([ "${at:-0}" -gt 0 ] && echo $(($(date +%s) - at)) || echo 0)" --arg why "${read_err:-}" \
  '{ok: true, id: $p.id, set: {CLAUDE_CONFIG_DIR: $p.folder}, unset: ($shed | split(" ")),
    read: {source: $source, at: $at, age: $age, problem: ($why | select(. != "") // null)}}'