#!/usr/bin/env bash
# juggernaut-axi - bounded, read-only fleet facts for external tools (AXI style).
#
# The approved design (data/juggernaut-axi/report.md), read-only commands so far:
# `status`, `tickets`, `decisions`, and `messages` (a task's steering-inbox records),
# plus the three writes `answer`, `message`, and `ticket`, each delegated to an existing
# guarded path (fm-captain-hold.sh, fm-send.sh, fm-tasks-axi.sh); it never closes tasks
# or writes state itself, and a result claims only what the durable record confirms. Like bin/fm-bearings-snapshot.sh it projects the canonical JSON model
# (fm-bearings-snapshot.sh / fm-fleet-snapshot.sh --json) and renders TOON at the
# output boundary (bin/fm-toon-lib.sh); `--json` prints the same model.
# Output contract: `juggernaut-axi.v1`; consumers ignore unknown fields.
# It never writes state, never reads task transcripts, and states every omission.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/fm-toon-lib.sh
# shellcheck disable=SC1091
. "$SCRIPT_DIR/fm-toon-lib.sh"
# shellcheck source=bin/fm-task-inbox-lib.sh
# shellcheck disable=SC1091
. "$SCRIPT_DIR/fm-task-inbox-lib.sh"

VERSION=0.1.0
TICKETS_MAX=100
MESSAGE_BYTES=8192
HOME_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
STATE=${FM_STATE_OVERRIDE:-${FM_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}/state}

usage() {
  cat <<'USAGE'
usage: juggernaut-axi <command> [--json]
       juggernaut-axi --help | --version

commands:
  status                 bounded current fleet projection
  tickets [--state <queued|in_flight|done>] [--repo <name>] [--limit <n>]
                         bounded backlog rows (default 50, at most 100)
  decisions              open captain holds (read-only; answering is a later slice)
  messages <task-id> [--limit <n>]
                         newest steering messages for one known task (default 20,
                         at most 100; bodies cut at 8 KiB)
  answer <task-id> <answer> [--release]
                         record the captain's answer to an open decision
  message <task-id> <text>
                         append a steering message to one known task (text of
                         at most 8 KiB, not starting with / or $)
  ticket <title> [--repo <name>] [--kind <ship|scout|docs>] [--priority <0-3>]
                         queue a new ticket (never starts work)

  serve [--port <n>] [--reads-per-minute <n>]
                         opt-in loopback (127.0.0.1) read-only HTTP API; needs an
                         owner-only token in config/juggernaut-axi-token

TOON by default; --json prints the same versioned model (juggernaut-axi.v1).
Errors go to stderr with a nonzero exit. Omitted rows are counted in omitted[].
USAGE
}

die() { echo "juggernaut-axi: $*" >&2; exit 2; }

jq_or_die() {  # <what> <jq args...> - reads the model on stdin
  local what=$1; shift
  jq "$@" || { echo "juggernaut-axi: $what projection failed" >&2; exit 1; }
}

cmd_status() {
  local snap
  snap=$("$SCRIPT_DIR/fm-bearings-snapshot.sh" --json) || { echo "juggernaut-axi: fleet snapshot failed" >&2; exit 1; }
  printf '%s\n' "$snap" | jq_or_die status '{
    schema: "juggernaut-axi.v1", view: "status", home, generated,
    counts: {in_flight: (.in_flight | length), decisions_open: (.decisions_open | length),
             secondmates: (.secondmates | length), gates: (.gates | length)},
    in_flight: [.in_flight[] | {id, kind, state, repo, name, doing}],
    omitted: .omitted}'
}

cmd_tickets() {
  local state="" repo="" limit=50
  while [ $# -gt 0 ]; do
    case "$1" in
      --state) [ $# -ge 2 ] || die "--state needs a value"; state=$2; shift ;;
      --repo) [ $# -ge 2 ] || die "--repo needs a value"; repo=$2; shift ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$2; shift ;;
      *) die "unknown tickets argument: $1" ;;
    esac
    shift
  done
  case "$state" in ''|queued|in_flight|done) ;; *) die "--state must be queued, in_flight, or done" ;; esac
  case "$limit" in ''|*[!0-9]*|0) die "--limit must be a positive integer" ;; esac
  [ "$limit" -le "$TICKETS_MAX" ] || limit=$TICKETS_MAX
  local snap
  snap=$("$SCRIPT_DIR/fm-fleet-snapshot.sh" --json) || { echo "juggernaut-axi: fleet snapshot failed" >&2; exit 1; }
  printf '%s\n' "$snap" | jq_or_die tickets --arg state "$state" --arg repo "$repo" --argjson limit "$limit" '
    [.backlog.records[] | select(.structured)
     | select($state == "" or .state == $state) | select($repo == "" or .repo == $repo)] as $all
    | {schema: "juggernaut-axi.v1", view: "tickets", home: (.fm_home | split("/") | .[-2:] | join("/")), generated,
       count: ($all | length),
       tickets: [$all[:$limit][] | {id, title, state, repo, kind, blocked_by: (.unresolved_blocker_ids | join(" "))}],
       omitted: (if ($all | length) > $limit then [{surface: "tickets beyond limit", count: (($all | length) - $limit), reveal: "--limit <n> (at most 100)"}] else [] end)}'
}

cmd_decisions() {
  local snap
  snap=$("$SCRIPT_DIR/fm-bearings-snapshot.sh" --json) || { echo "juggernaut-axi: fleet snapshot failed" >&2; exit 1; }
  printf '%s\n' "$snap" | jq_or_die decisions '{
    schema: "juggernaut-axi.v1", view: "decisions", home, generated,
    count: (.decisions_open | length),
    decisions: [.decisions_open[] | {id, key, verb, summary, owner}],
    omitted: [.omitted[] | select(.surface | test("decision|hold"; "i"))]}'
}

cmd_messages() {
  local task="" limit=20 f seq at body rows="" n
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$2; shift ;;
      -*) die "unknown messages argument: $1" ;;
      *) [ -z "$task" ] || die "messages takes one task id"; task=$1 ;;
    esac
    shift
  done
  [ -n "$task" ] || die "messages needs a task id"
  case "$task" in [A-Za-z0-9]*) ;; *) die "invalid task id" ;; esac
  case "$task" in *[!A-Za-z0-9._-]*) die "invalid task id" ;; esac
  case "$limit" in ''|*[!0-9]*|0) die "--limit must be a positive integer" ;; esac
  [ "$limit" -le "$TICKETS_MAX" ] || limit=$TICKETS_MAX
  local dir hdir
  dir=$(fm_task_inbox_dir "$STATE" "$task"); hdir=$(fm_task_inbox_handled_dir "$STATE" "$task")
  [ -d "$dir" ] || [ -e "$STATE/$task.meta" ] || die "unknown task: $task"
  local files
  files=$(for f in "$dir"/*.msg "$hdir"/*.msg; do
    [ -f "$f" ] && seq=$(fm_task_inbox_seq_of "${f##*/}") && printf '%s\t%s\n' "$seq" "$f"
  done | sort -n)
  n=$(printf '%s' "$files" | grep -c . || true)
  while IFS=$'\t' read -r seq f; do
    [ -n "$f" ] || continue
    at=$(sed -n 's/^at=//p;/^--$/q' "$f" | head -n1)
    body=$(fm_task_inbox_body "$f" | head -c "$MESSAGE_BYTES")
    rows+=$(jq -nc --argjson id "$seq" --arg at "$at" --arg state "$([ "${f%/*}" = "$hdir" ] && echo handled || echo pending)" \
      --arg body "$body" --argjson cut "$([ "$(wc -c < "$f")" -gt $((MESSAGE_BYTES + 200)) ] && echo true || echo false)" \
      '{id: $id, at: $at, state: $state, body: $body, truncated: $cut}')$'\n'
  done < <(printf '%s\n' "$files" | tail -n "$limit")
  printf '%s' "$rows" | jq_or_die messages -s --arg task "$task" --argjson total "$n" --argjson limit "$limit" '
    {schema: "juggernaut-axi.v1", view: "messages", task: $task, count: $total, messages: .,
     omitted: (if $total > $limit then [{surface: "older messages", count: ($total - $limit), reveal: "--limit <n> (at most 100)"}] else [] end)}'
}

write_result() {  # <action> <task> <confirmed true|false> <note>
  jq -nc --arg action "$1" --arg task "$2" --argjson confirmed "$3" --arg note "$4" \
    '{schema: "juggernaut-axi.v1", view: "write", action: $action, task: $task, ok: true, confirmed: $confirmed, note: $note}'
}

known_task_id() {  # <id> - shape only; callers prove the task exists
  case "$1" in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) die "invalid task id" ;; esac
}

cmd_answer() {
  local task="" text="" mode="" f
  while [ $# -gt 0 ]; do
    case "$1" in
      --release) mode=--release ;;
      -*) die "unknown answer argument: $1" ;;
      *) if [ -z "$task" ]; then task=$1; elif [ -z "$text" ]; then text=$1; else die "answer takes a task id and one answer"; fi ;;
    esac
    shift
  done
  known_task_id "$task"
  [ -n "$text" ] || die "answer needs the answer text"
  [ "$(printf '%s' "$text" | wc -c)" -le 8192 ] || die "answer is over 8192 bytes"
  "$HOME_ROOT/bin/fm-captain-hold.sh" open "$task" >/dev/null || die "$task is not an open captain decision"
  f=$(mktemp) || exit 1
  printf '%s\n' "$text" > "$f"
  "$HOME_ROOT/bin/fm-captain-hold.sh" answer "$task" --decision-file "$f" ${mode:+"$mode"} >&2
  local rc=$?
  rm -f -- "$f"
  [ "$rc" -eq 0 ] || exit "$rc"
  if "$HOME_ROOT/bin/fm-captain-hold.sh" answered "$task"; then
    write_result answer "$task" true "answer recorded by fm-captain-hold.sh"
  else
    write_result answer "$task" false "answer accepted but the durable record does not confirm it yet"
  fi
}

cmd_message() {
  local task="" text=""
  [ $# -eq 2 ] || die "message takes a task id and the text"
  task=$1; text=$2
  known_task_id "$task"
  [ -e "$STATE/$task.meta" ] || die "unknown task: $task"
  [ -n "${text//[[:space:]]/}" ] || die "message text is empty"
  [ "$(printf '%s' "$text" | wc -c)" -le "$MESSAGE_BYTES" ] || die "message is over $MESSAGE_BYTES bytes"
  case "$text" in /*|\$*) die "message must not start with / or $ (those reach the terminal, not the inbox)" ;; esac
  FM_HOME=${FM_HOME:-$HOME_ROOT} "$HOME_ROOT/bin/fm-send.sh" "$task" "$text" >&2 || exit $?
  write_result message "$task" true "steering record written; the worker acting on it is not confirmed"
}

cmd_ticket() {
  local title="" args=() out
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo|--kind|--priority) [ $# -ge 2 ] || die "$1 needs a value"; args+=("$1" "$2"); shift ;;
      -*) die "unknown ticket argument: $1" ;;
      *) [ -z "$title" ] || die "ticket takes one title"; title=$1 ;;
    esac
    shift
  done
  [ -n "$title" ] || die "ticket needs a title"
  local i
  for ((i = 0; i < ${#args[@]}; i += 2)); do
    case "${args[i]}:${args[i+1]}" in
      --kind:ship|--kind:scout|--kind:docs) ;;
      --kind:*) die "--kind must be ship, scout, or docs" ;;
      --priority:[0-3]) ;;
      --priority:*) die "--priority must be 0-3" ;;
    esac
  done
  out=$(FM_HOME=${FM_HOME:-$HOME_ROOT} "$HOME_ROOT/bin/fm-tasks-axi.sh" add --mint "$title" "${args[@]}" --json) || exit $?
  printf '%s\n' "$out" | jq -c '{schema: "juggernaut-axi.v1", view: "write", action: "ticket", task: .task.id, ok: .ok, confirmed: (.task.state == "queued"), note: "queued by tasks-axi", ticket: (.task | {id, title, state, repo, kind})}' \
    || { echo "juggernaut-axi: ticket result unreadable" >&2; exit 1; }
}

case "${1:-}" in
  -h|--help|help|"") usage; [ -n "${1:-}" ] || exit 2; exit 0 ;;
  --version) echo "juggernaut-axi $VERSION"; exit 0 ;;
  serve) shift; JUGGERNAUT_AXI_HOME=${FM_HOME:-$HOME_ROOT} exec python3 "$SCRIPT_DIR/juggernaut-axi-serve.py" "$@" ;;
esac
CMD=$1; shift
FORMAT=toon
ARGS=()
for a in "$@"; do
  case "$a" in --json) FORMAT=json ;; *) ARGS+=("$a") ;; esac
done
case "$CMD" in
  status|tickets|decisions|messages|answer|message|ticket) ;;
  *) die "unknown command: $CMD (try --help)" ;;
esac
MODEL=$("cmd_$CMD" "${ARGS[@]+"${ARGS[@]}"}") || exit $?
if [ "$FORMAT" = json ]; then
  printf '%s\n' "$MODEL"
else
  printf '%s\n' "$MODEL" | jq -r "$FM_TOON_JQ" || { echo "juggernaut-axi: TOON rendering failed" >&2; exit 1; }
fi
