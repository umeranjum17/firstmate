#!/usr/bin/env python3
"""Wake Main when a running fleet process carries a provider API key in its environment.

Read-only on /proc: /proc/<pid>/environ is split on NUL and only the variable
NAMES are kept (a value never leaves that expression: never stored, printed,
logged or written) and matched against FM_KEY_PATTERNS (comma or space
separated globs; or the home's config/key-in-env-patterns; else DEFAULT).
Each hit is attributed to a home and task through the cwd of the process (or
its nearest ancestor) against every home's state/*.meta worktree= record, and
the parent chain is walked to the topmost ancestor holding the same variable.
Output: state/key-in-env.incidents, one TSV line per process (pid, home, task,
variables, topmost parent), rewritten each run; one wake line on stdout when
the set changes (de-duplicated via state/.key-in-env.last). Nothing is killed,
signalled or changed. Fixture knobs: FM_KEY_HOMES (colon list of home dirs),
FM_KEY_TREES (comma list of pids: scan only them and their descendants), FM_PROC.
"""
import fnmatch, hashlib, os, re, sys

PROVIDERS = "OPENROUTER ANTHROPIC OPENAI MINIMAX GOOGLE GEMINI XAI MOONSHOT ZAI DEEPSEEK MISTRAL GROQ COHERE TOGETHER FIREWORKS".split()
DEFAULT = ["*_API_KEY", "*_API_TOKEN"] + [f"{p}_*{s}" for p in PROVIDERS for s in ("KEY", "TOKEN", "SECRET")]

PROC = os.environ.get("FM_PROC", "/proc")
HOME = os.environ.get("FM_HOME") or os.path.expanduser("~/firstmate")
STATE = os.path.join(HOME, "state")

def patterns():
    raw = os.environ.get("FM_KEY_PATTERNS")
    if raw is None:
        try:
            raw = open(os.path.join(HOME, "config", "key-in-env-patterns")).read()
        except OSError:
            return DEFAULT
    return re.split(r"[\s,]+", raw.strip()) if raw.strip() else DEFAULT

def env_names(pid):
    """Variable names of one process; the values are dropped inside this expression."""
    try:
        with open(f"{PROC}/{pid}/environ", "rb") as f:
            return {e.split(b"=", 1)[0].decode("utf-8", "replace") for e in f.read().split(b"\0") if e}
    except OSError:
        return set()

def stat_of(pid):
    """(ppid, command) from /proc/<pid>/stat; comm may hold spaces, so split on the last ')'."""
    try:
        s = open(f"{PROC}/{pid}/stat").read()
    except OSError:
        return None
    l, r = s.index("("), s.rindex(")")
    return int(s[r + 2:].split()[1]), s[l + 1:r]

def homes():
    dirs = os.environ.get("FM_KEY_HOMES")
    if dirs is None:
        base = os.path.expanduser("~/.treehouse")
        dirs = ":".join([HOME, os.path.expanduser("~/firstmate")] + sorted(
            os.path.join(base, a, b, "firstmate") for a in os.listdir(base) if os.path.isdir(os.path.join(base, a))
            for b in os.listdir(os.path.join(base, a))))
    out = {}
    for d in dirs.split(":"):
        if os.path.isdir(os.path.join(d, "state")):
            out[os.path.realpath(d)] = d
    return out

def task_map(hs):
    """[(worktree realpath, home label, task)] from every home's state/*.meta."""
    m = []
    for real, d in hs.items():
        parts = real.split(os.sep)
        label = "main" if real == os.path.realpath(os.path.expanduser("~/firstmate")) else "/".join(parts[-3:-1])
        m.append((real, label, "-"))
        sd = os.path.join(d, "state")
        for f in os.listdir(sd):
            if f.endswith(".meta"):
                try:
                    wt = next((l.split("=", 1)[1].strip() for l in open(os.path.join(sd, f)) if l.startswith("worktree=")), "")
                except OSError:
                    continue
                if wt:
                    m.append((os.path.realpath(wt), label, f[:-5]))
    return sorted(m, key=lambda t: -len(t[0]))

def attribute(pid, tmap, chain):
    for p in [pid] + chain:
        try:
            cwd = os.readlink(f"{PROC}/{p}/cwd")
        except OSError:
            continue
        for wt, label, task in tmap:
            if cwd == wt or cwd.startswith(wt + os.sep):
                return label, task
    return "unknown", "-"

def main():
    os.makedirs(STATE, exist_ok=True)
    pats, me, uid = patterns(), os.getpid(), os.getuid()
    names, info = {}, {}
    for e in os.listdir(PROC):
        if not e.isdigit():
            continue
        pid = int(e)
        try:
            if os.stat(f"{PROC}/{e}").st_uid != uid:
                continue
        except OSError:
            continue
        st = stat_of(pid)
        if st is None:
            continue
        info[pid] = st
        hit = {n for n in env_names(pid) if any(fnmatch.fnmatchcase(n, p) for p in pats)}
        if hit:
            names[pid] = hit
    tmap = task_map(homes())
    trees = {int(t) for t in os.environ.get("FM_KEY_TREES", "").split(",") if t}
    rows = []
    for pid in sorted(names):
        if pid == me:
            continue
        chain, p = [], info[pid][0]
        while p in info and p > 1 and p not in chain:
            chain.append(p)
            p = info[p][0]
        if trees and not trees & {pid, *chain}:
            continue
        top = pid
        for a in chain:  # topmost ancestor that holds one of the same variables
            if names.get(a, set()) & names[pid]:
                top = a
        home, task = attribute(pid, tmap, chain)
        rows.append((pid, home, task, ",".join(sorted(names[pid])), f"{info[top][1]}({top})"))
    lines = ["\t".join(map(str, r)) for r in rows]
    inc = os.path.join(STATE, "key-in-env.incidents")
    open(inc + ".tmp", "w").write("".join(l + "\n" for l in lines))
    os.replace(inc + ".tmp", inc)
    sig = hashlib.sha256("\n".join(lines).encode()).hexdigest()
    last = os.path.join(STATE, ".key-in-env.last")
    try:
        prev = open(last).read().strip()
    except OSError:
        prev = ""
    open(last, "w").write(sig + "\n")
    if not rows or sig == prev:
        return
    tops = {}
    for r in rows:
        c = r[4].rsplit("(", 1)[0]
        tops[c] = tops.get(c, 0) + 1
    top = ", ".join(f"{c} x{n}" for c, n in sorted(tops.items(), key=lambda t: -t[1])[:4])
    homes_n = len({r[1] for r in rows})
    shown = "; ".join(f"pid {r[0]} {r[1]} {r[2]} {r[3]}" for r in rows[:3])
    print(f"key-in-env: {len(rows)} process(es) in {homes_n} home(s) carry a provider API key in their environment (names only): {shown}; topmost parent still exporting: {top} - full list {inc}")


if __name__ == "__main__":
    sys.exit(main())
